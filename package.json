{
  "name": "cinematography",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "lint": "eslint",
    "test": "vitest run",
    "preview": "vite preview",
    "clean": "rmdir /s /q node_modules && del package-lock.json",
    "reinstall": "npm run clean && npm install",
    "cinematography:build": "npm run build",
    "deploy:nginx": "npm run cinematography:build && powershell Copy-Item -Recurse -Force -Path build\\* D:\\nginx-1.31.6\\html\\",
    "deploy:dv": "npm run build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File .devops/deploy.ps1 -Environment DEV -Build",
    "build:deploy:dv": "npm run deploy:dv"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5"
  }
}
